    <entry xml:lang="en">
        <title>ਜਾਣਨਾ ਚਾਹੁੰਦਾ ਹਾਂ</title>
        <published>2022-11-24T00:00:00+00:00</published>
        <updated>2022-11-24T00:00:00+00:00</updated>
        
        <author>
          <name>Unknown</name>
        </author>
        
        <link rel="alternate" type="text/html" href="https://hemish.net/poems/jaanna-chahunda-haan/"/>
        <id>https://hemish.net/poems/jaanna-chahunda-haan/</id>
        
        <summary type="html">&lt;p&gt;ਮੈਂ ਖਾਸ ਹਾਂ,&lt;br /&gt;
ਇਹ ਮੈਂ ਜਾਣਦਾ ਹਾਂ,&lt;br /&gt;
ਤੇ ਏਸੇ ਖਾਸ ਖੁਦ ਨੂੰ,&lt;br /&gt;
ਪਛਾਣਨਾ ਚਾਹੁੰਦਾ ਹਾਂ।&lt;/p&gt;</summary>
        
